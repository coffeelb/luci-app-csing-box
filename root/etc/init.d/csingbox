#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Csing-box - a simplified homeproxy client
# Based on luci-app-homeproxy (C) 2022-2025 ImmortalWrt.org

USE_PROCD=1

START=99
STOP=10

CONF="csingbox"
PROG="/usr/bin/sing-box"

HP_DIR="/etc/csingbox"
RUN_DIR="/var/run/csingbox"
LOG_PATH="$RUN_DIR/csingbox.log"

# we don't know which is the default server, just take the first one
DNSMASQ_UCI_CONFIG="$(uci -q show "dhcp.@dnsmasq[0]" | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')"
if [ -f "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG" ]; then
	DNSMASQ_DIR="$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG")/dnsmasq-csingbox.d"
else
	DNSMASQ_DIR="/tmp/dnsmasq.d/dnsmasq-csingbox.d"
fi

log() {
	echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

start_service() {
	config_load "$CONF"

	local routing_mode proxy_mode main_node CONFIG_FILE
	config_get routing_mode "config" "routing_mode" "bypass_mainland_china"
	config_get proxy_mode "config" "proxy_mode" "redirect_tproxy"
	config_get main_node "config" "main_node" "nil"
	# When node selection is disabled (nil), the service is not started in any mode (including Clash panel)
	[ "$main_node" != "nil" ] || return 1
	if [ "$routing_mode" = "panel" ]; then
		uci -q get "csingbox.@node[0]" >/dev/null 2>&1 || return 1
	fi

	mkdir -p "$RUN_DIR" "$HP_DIR/certs"

	# Clear the sing-box log on every start
	echo > "$RUN_DIR/sing-box-c.log" 2>"/dev/null"

	# Generate/Validate client config
	ucode -S "$HP_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH"
	# The persistent panel template contains node credentials and the panel secret; tighten permissions
	if [ "$routing_mode" = "panel" ]; then
		chmod 600 "$HP_DIR/sing-box-panel.json" 2>"/dev/null"
	fi
	if [ "$routing_mode" = "panel" ]; then
		CONFIG_FILE="$RUN_DIR/sing-box-panel.json"
	else
		CONFIG_FILE="$RUN_DIR/sing-box-c.json"
	fi
	if [ ! -e "$CONFIG_FILE" ]; then
		log "Error: failed to generate client configuration."
		return 1
	elif ! "$PROG" check --config "$CONFIG_FILE" 2>>"$LOG_PATH"; then
		log "Error: wrong client configuration detected."
		return 1
	fi

	# Cron: rule files are auto-updated every Sunday at 03:00
	local auto_update
	config_get_bool auto_update "config" "auto_update" "1"
	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"
	if [ "$auto_update" = "1" ]; then
		echo -e "0 3 * * 0 $HP_DIR/scripts/update_resources.sh all #${CONF}_autosetup" >> "/etc/crontabs/root"
	fi

	# Cron: subscription auto-update
	local sub_auto_update sub_auto_update_time
	config_get_bool sub_auto_update "subscription" "auto_update" "0"
	if [ "$sub_auto_update" = "1" ]; then
		config_get sub_auto_update_time "subscription" "auto_update_time" "2"
		echo -e "0 $sub_auto_update_time * * * $HP_DIR/scripts/update_subscriptions.uc #${CONF}_autosetup" >> "/etc/crontabs/root"
	fi
	/etc/init.d/cron restart >"/dev/null" 2>&1

	# DNSMasq rules
	local ipv6_support dns_port
	config_get_bool ipv6_support "config" "ipv6_support" "0"
	config_get dns_port "infra" "dns_port" "6333"
	mkdir -p "$DNSMASQ_DIR"
	echo -e "conf-dir=$DNSMASQ_DIR" > "$DNSMASQ_DIR/../dnsmasq-csingbox.conf"
	case "$routing_mode" in
	"bypass_mainland_china"|"global"|"panel")
		cat <<-EOF >> "$DNSMASQ_DIR/redirect-dns.conf"
			no-poll
			no-resolv
			server=127.0.0.1#$dns_port
		EOF
		;;
	"gfwlist")
		local gfw_nftset_v6
		[ "$ipv6_support" -eq "0" ] || gfw_nftset_v6=",6#inet#fw4#csingbox_gfw_list_v6"
		sed -r -e "s/(.*)/server=\/\1\/127.0.0.1#$dns_port\nnftset=\/\1\\/4#inet#fw4#csingbox_gfw_list_v4$gfw_nftset_v6/g" \
			"$HP_DIR/resources/gfw_list.txt" > "$DNSMASQ_DIR/gfw_list.conf"
		;;
	esac

	# Forced proxy list (proxy_list.txt) -> write forced proxy IP sets back to nftset
	if [ -s "$HP_DIR/resources/proxy_list.txt" ]; then
		local wan_nftset_v6
		[ "$ipv6_support" -eq "0" ] || wan_nftset_v6=",6#inet#fw4#csingbox_wan_proxy_addr_v6"
		sed -r -e '/^\s*$/d' -e "s/(.*)/server=\/\1\/127.0.0.1#$dns_port\nnftset=\/\1\\/4#inet#fw4#csingbox_wan_proxy_addr_v4$wan_nftset_v6/g" \
			"$HP_DIR/resources/proxy_list.txt" > "$DNSMASQ_DIR/proxy_list.conf"
	fi
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	# Setup tproxy routing table
	local table_mark tproxy_mark
	config_get table_mark "infra" "table_mark" "200"
	case "$proxy_mode" in
	"redirect_tproxy")
		config_get tproxy_mark "infra" "tproxy_mark" "201"
		ip rule add fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
		ip route add local 0.0.0.0/0 dev lo table "$table_mark" 2>"/dev/null"
		if [ "$ipv6_support" -eq "1" ]; then
			ip -6 rule add fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
			ip -6 route add local ::/0 dev lo table "$table_mark" 2>"/dev/null"
		fi
		;;
	esac

	# sing-box (client)
	procd_open_instance "sing-box-c"
	procd_set_param command "$PROG"
	procd_append_param command run --config "$CONFIG_FILE"

	# QUIC-GO GSO is broken on kernel 6.6 currently
	uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"

	if [ -x "/sbin/ujail" ] && ! grep -Eq '"type": "(wireguard|tun)"' "$CONFIG_FILE"; then
		procd_add_jail "sing-box-c" log procfs
		procd_add_jail_mount "$CONFIG_FILE"
		procd_add_jail_mount_rw "$RUN_DIR/sing-box-c.log"
		if [ "$routing_mode" = "bypass_mainland_china" -o "$routing_mode" = "panel" ]; then
			procd_add_jail_mount_rw "$RUN_DIR/cache.db"
		fi
		procd_add_jail_mount "$HP_DIR/certs/"
		procd_add_jail_mount "$HP_DIR/resources/"
		procd_add_jail_mount "/etc/ssl/"
		procd_add_jail_mount "/etc/localtime"
		procd_add_jail_mount "/etc/TZ"
		procd_set_param capabilities "/etc/capabilities/csingbox.json"
		procd_set_param no_new_privs 1
		procd_set_param user sing-box
		procd_set_param group sing-box
	fi

	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# Log size limit is 50KB; truncate when exceeded
	procd_open_instance "log-cleaner"
	procd_set_param command "$HP_DIR/scripts/clean_log.sh"
	procd_set_param respawn
	procd_close_instance

	# Prepare cache db
	if [ "$routing_mode" = "bypass_mainland_china" -o "$routing_mode" = "panel" ]; then
		[ -e "$RUN_DIR/cache.db" ] || touch "$RUN_DIR/cache.db"
	fi

	# Update permissions for ujail
	chown -R sing-box:sing-box "$RUN_DIR"

	# Setup firewall
	utpl -S "$HP_DIR/scripts/firewall_post.ut" > "$RUN_DIR/fw4_post.nft"
	fw4 reload >"/dev/null" 2>&1

	log "sing-box $(sing-box version -n) started."
}

stop_service() {
	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"
	/etc/init.d/cron restart >"/dev/null" 2>&1

	# Load config
	config_load "$CONF"
	local table_mark tproxy_mark
	config_get table_mark "infra" "table_mark" "200"
	config_get tproxy_mark "infra" "tproxy_mark" "201"

	# Tproxy
	ip rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
	ip route del local 0.0.0.0/0 dev lo table "$table_mark" 2>"/dev/null"
	ip -6 rule del fwmark "$tproxy_mark" table "$table_mark" 2>"/dev/null"
	ip -6 route del local ::/0 dev lo table "$table_mark" 2>"/dev/null"

	# Nftables rules
	for i in "csingbox_dstnat_redir" "csingbox_output_redir" \
		 "csingbox_redirect" "csingbox_redirect_proxy" \
		 "csingbox_redirect_proxy_port" "csingbox_redirect_lanac" \
		 "csingbox_mangle_prerouting" "csingbox_mangle_output" \
		 "csingbox_mangle_tproxy" "csingbox_mangle_tproxy_port" \
		 "csingbox_mangle_lanac" "csingbox_mangle_mark"; do
		nft flush chain inet fw4 "$i"
		nft delete chain inet fw4 "$i"
	done 2>"/dev/null"
	for i in "csingbox_local_addr_v4" "csingbox_local_addr_v6" \
		 "csingbox_gfw_list_v4" "csingbox_gfw_list_v6" \
		 "csingbox_mainland_addr_v4" "csingbox_mainland_addr_v6" \
		 "csingbox_wan_proxy_addr_v4" "csingbox_wan_proxy_addr_v6" \
		 "csingbox_routing_port"; do
		nft flush set inet fw4 "$i"
		nft delete set inet fw4 "$i"
	done 2>"/dev/null"
	echo > "$RUN_DIR/fw4_post.nft"
	fw4 reload >"/dev/null" 2>&1

	# Remove DNS hijack
	rm -rf "$DNSMASQ_DIR/../dnsmasq-csingbox.conf" "$DNSMASQ_DIR"
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-c.log"

	log "Service stopped."
}

reload_service() {
	log "Reloading service..."

	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}
