#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Csing-box - a simplified homeproxy client
# Based on luci-app-homeproxy (C) 2022-2025 ImmortalWrt.org

USE_PROCD=1

START=99
STOP=10

CONF="csingbox"
PROG="/usr/bin/sing-box"

CS_DIR="/etc/csingbox"
RUN_DIR="/var/run/csingbox"
LOG_PATH="$RUN_DIR/csingbox.log"

# we don't know which is the default server, just take the first one
DNSMASQ_UCI_CONFIG="$(uci -q show "dhcp.@dnsmasq[0]" | awk 'NR==1 {split($0, conf, /[.=]/); print conf[2]}')"
if [ -f "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG" ]; then
	DNSMASQ_DIR="$(awk -F '=' '/^conf-dir=/ {print $2}' "/tmp/etc/dnsmasq.conf.$DNSMASQ_UCI_CONFIG")/dnsmasq-csingbox.d"
else
	DNSMASQ_DIR="/tmp/dnsmasq.d/dnsmasq-csingbox.d"
fi

log() {
	echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

start_service() {
	config_load "$CONF"

	local main_node CONFIG_FILE
	config_get main_node "config" "main_node" "nil"
	# When node selection is disabled (nil), the service is not started
	[ "$main_node" != "nil" ] || return 1
	uci -q get "csingbox.@node[0]" >/dev/null 2>&1 || return 1

	mkdir -p "$RUN_DIR" "$CS_DIR/certs"

	# find_neighbor watches the dnsmasq lease file; it must exist before sing-box starts.
	touch "/tmp/dhcp.leases"

	# Clear the sing-box log on every start
	echo > "$RUN_DIR/sing-box-c.log" 2>"/dev/null"

	# This package targets sing-box 1.15.0 or newer: the generated TUN relies on the native
	# TCP/IP stack (no `stack` option, deprecated in 1.15.0) plus the 1.14 fields
	# (dns_mode, exclude_mptcp); older cores reject the configuration.
	local core_version
	core_version="$("$PROG" version -n 2>"/dev/null")"
	if [ -n "$core_version" ]; then
		local core_number
		core_number="$(echo "$core_version" | awk -F. '{printf "%d%03d%03d", $1, $2, $3}')"
		if [ -n "$core_number" ] && [ "$core_number" -lt 1015000 ] 2>"/dev/null"; then
			log "Error: sing-box 1.15.0 or newer is required, found $core_version."
			return 1
		fi
	fi

	# Generate/Validate client config
	ucode -S "$CS_DIR/scripts/generate_client.uc" 2>>"$LOG_PATH"
	# The persistent panel template contains node credentials and the panel secret; tighten permissions
	chmod 600 "$CS_DIR/sing-box-panel.json" 2>"/dev/null"
	CONFIG_FILE="$RUN_DIR/sing-box-panel.json"
	if [ ! -e "$CONFIG_FILE" ]; then
		log "Error: failed to generate client configuration."
		return 1
	elif ! "$PROG" check --config "$CONFIG_FILE" 2>>"$LOG_PATH"; then
		log "Error: wrong client configuration detected (this package needs sing-box 1.15.0 or newer, found ${core_version:-unknown})."
		return 1
	fi

	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"

	# Cron: subscription auto-update
	local sub_auto_update sub_auto_update_time
	config_get_bool sub_auto_update "subscription" "auto_update" "0"
	if [ "$sub_auto_update" = "1" ]; then
		config_get sub_auto_update_time "subscription" "auto_update_time" "2"
		echo -e "0 $sub_auto_update_time * * * $CS_DIR/scripts/update_subscriptions.uc #${CONF}_autosetup" >> "/etc/crontabs/root"
	fi
	/etc/init.d/cron restart >"/dev/null" 2>&1

	# DNSMasq rules: clients using the router as resolver are forwarded to the sing-box DNS
	# inbound; DNS queries sent to external servers are hijacked by the TUN itself.
	local dns_port
	config_get dns_port "infra" "dns_port" "6333"
	mkdir -p "$DNSMASQ_DIR"
	echo -e "conf-dir=$DNSMASQ_DIR" > "$DNSMASQ_DIR/../dnsmasq-csingbox.conf"
	cat <<-EOF >> "$DNSMASQ_DIR/redirect-dns.conf"
		no-poll
		no-resolv
		server=127.0.0.1#$dns_port
	EOF
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	start_singbox_instance "$CONFIG_FILE"

	# Log size limit is 50KB; truncate when exceeded
	procd_open_instance "log-cleaner"
	procd_set_param command "$CS_DIR/scripts/clean_log.sh"
	procd_set_param respawn
	procd_close_instance

	# Prepare cache db
	[ -e "$RUN_DIR/cache.db" ] || touch "$RUN_DIR/cache.db"

	# Dashboard directory; the downloaded archive is unpacked next to it as dashboard.tmp
	mkdir -p "$CS_DIR/ui/dashboard"

	log "sing-box $(sing-box version -n) started."
}

start_singbox_instance() {
	local config_file="$1"

	procd_open_instance "sing-box-c"
	procd_set_param command "$PROG"
	procd_append_param command run --config "$config_file"

	# QUIC-GO GSO is broken on kernel 6.6 currently
	uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO=true"

	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>"/dev/null"
	/etc/init.d/cron restart >"/dev/null" 2>&1

	# The TUN interface, its routes and sing-box's own nftables rules are cleaned up by
	# sing-box itself.

	# Remove DNS redirect
	rm -rf "$DNSMASQ_DIR/../dnsmasq-csingbox.conf" "$DNSMASQ_DIR"
	/etc/init.d/dnsmasq restart >"/dev/null" 2>&1

	rm -f "$RUN_DIR/sing-box-panel.json" "$RUN_DIR/sing-box-c.log"

	log "Service stopped."
}

reload_service() {
	log "Reloading service..."

	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}
